//
//  Secrets.xcconfig.example
//
//  1. Скопируйте файл: cp Configs/Secrets.xcconfig.example Configs/Secrets.xcconfig
//  2. Впишите ключ, полученный на https://www.omdbapi.com/apikey.aspx
//  Secrets.xcconfig добавлен в .gitignore — не коммитьте его.
//
//  На CI ключ можно передать без файла: xcodebuild ... OMDB_API_KEY=$OMDB_API_KEY
//

OMDB_API_KEY = your_omdb_api_key
